{
  "name": "@jhae/github-page-template",
  "version": "0.0.0",
  "author": {
    "name": "JHAE",
    "url": "https://github.com/jhae-de"
  },
  "repository": {
    "url": "https://github.com/jhae-de/github-page-template.git",
    "type": "git"
  },
  "homepage": "https://github.com/jhae-de/github-page-template",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run-script build:scripts",
    "build:scripts": "npx tsx ./build-scripts.ts",
    "fix": "npm run-script fix:prettier && npm run-script fix:sass",
    "fix:prettier": "prettier . --write",
    "fix:sass": "stylelint ./_sass --fix --formatter verbose",
    "lint": "npm run-script lint:prettier && npm run-script lint:eslint && npm run-script lint:sass",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lint:sass": "stylelint ./_sass --formatter verbose --quiet",
    "postinstall": "./bin/post-install.sh",
    "test": "jest",
    "test:coverage": "npm run-script test -- --coverage",
    "watch:scripts": "npm run-script build:scripts -- --watch",
    "watch:test": "npm run-script test -- --watchAll",
    "watch:test:coverage": "npm run-script watch:test -- --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17",
    "@fontsource-variable/roboto-flex": "^5.1",
    "@fontsource-variable/roboto-mono": "^5.1",
    "@fortawesome/fontawesome-free": "^6.7",
    "@fortawesome/fontawesome-svg-core": "^6.7",
    "@jhae/stylelint-config-strict-scss": "^3.1",
    "@savvywombat/tailwindcss-grid-areas": "^4.0",
    "@shopify/prettier-plugin-liquid": "^1.6",
    "@types/jest": "^29.5",
    "@types/jsdom": "^21.1",
    "@types/node": "^20.17",
    "autoprefixer": "^10.4",
    "cssnano": "^7.0",
    "esbuild": "^0.24",
    "eslint": "^9.17",
    "eslint-config-prettier": "^9.1",
    "eslint-plugin-prettier": "^5.2",
    "globals": "^15.14",
    "jest": "^29.7",
    "jest-environment-jsdom": "^29.7",
    "jsdom": "^25.0",
    "postcss": "^8.4",
    "postcss-cli": "^11.0",
    "prettier": "^3.4",
    "prettier-plugin-tailwindcss": "^0.6",
    "rfs": "^10.0",
    "tailwindcss": "^3.4",
    "ts-jest": "^29.2",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "typescript-eslint": "^8.18"
  }
}
